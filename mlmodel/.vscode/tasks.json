{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Visual Studio 17 2022",
                "-A",
                "x64"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Configure CMake project with MSVC and CUDA"
        },
        {
            "label": "CMake: Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$msCompile"],
            "dependsOn": ["CMake: Configure"],
            "detail": "Build project in Debug mode"
        },
        {
            "label": "CMake: Build Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"],
            "dependsOn": ["CMake: Configure"],
            "detail": "Build project in Release mode"
        },
        {
            "label": "CMake: Clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Clean build artifacts"
        },
        {
            "label": "CMake: Rebuild Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug",
                "--clean-first"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$msCompile"],
            "dependsOn": ["CMake: Configure"],
            "detail": "Clean and rebuild in Debug mode"
        },
        {
            "label": "CMake: Rebuild Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Release",
                "--clean-first"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$msCompile"],
            "dependsOn": ["CMake: Configure"],
            "detail": "Clean and rebuild in Release mode"
        },
        {
            "label": "Run Debug",
            "type": "process",
            "command": "${workspaceFolder}/build/Debug/mlmodel.exe",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "detail": "Run the Debug executable"
        },
        {
            "label": "Run Release",
            "type": "process",
            "command": "${workspaceFolder}/build/Release/mlmodel.exe",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "detail": "Run the Release executable"
        },
        {
            "label": "Build and Run Debug",
            "dependsOn": [
                "CMake: Build Debug",
                "Run Debug"
            ],
            "dependsOrder": "sequence",
            "group": "test",
            "problemMatcher": [],
            "detail": "Build in Debug mode and run"
        },
        {
            "label": "Build and Run Release",
            "dependsOn": [
                "CMake: Build Release",
                "Run Release"
            ],
            "dependsOrder": "sequence",
            "group": "test",
            "problemMatcher": [],
            "detail": "Build in Release mode and run"
        },
        {
            "label": "Delete Build Cache",
            "type": "shell",
            "command": "rmdir",
            "args": [
                "/s",
                "/q",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Delete the build directory to force reconfigure"
        }
    ]
}